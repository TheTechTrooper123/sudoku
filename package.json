{
  "name": "sudoku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sudoku web app with puzzle generation, notes, hints and i18n (DE/EN).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:api",
    "build:api": "esbuild server/puzzle.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/puzzle.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
