# Server-side secrets (never exposed to the browser).
# Copy to `.env` for local development, and set the same key in the
# Vercel dashboard (Project → Settings → Environment Variables).

# API key for https://www.youdosudoku.com/api
# Leave empty to use the built-in fallback key from server/lib/config.ts.
YOUDOSUDOKU_API_KEY=

# Public origin of the deployed site (used for canonical URLs in SEO files).
SITE_URL=https://sudoku-game.ddnsfree.com
